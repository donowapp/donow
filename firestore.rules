rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: readable by any logged-in user.
    // Owners may edit only their own profile fields; sensitive fields
    // (role, isVerified, status, emailConfirmed, counts) are admin/server only.
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'phone', 'address', 'city', 'state', 'pincode',
                     'bio', 'profileImage', 'savedDonations', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Donations: publicly readable; create requires auth; update by owner, admin, or limited fields
    match /donations/{donationId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['interestedUsers', 'viewCount', 'updatedAt'])
      );
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Conversations: participants only
    match /conversations/{convId} {
      allow read: if isAuth() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isAuth() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if isAuth() && request.auth.uid == request.resource.data.senderId;
        allow update: if isAuth() &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'content']);
        allow delete: if false;
      }
    }

    // Notifications: only the recipient can read/update/delete.
    // Creation is attributable — the creator must stamp their own uid.
    match /notifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // Reviews: publicly readable; create by authenticated users only; immutable
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.reviewerId;
      allow update, delete: if false;
    }

    // Admin action logs: admins only
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Platform settings: publicly readable (drives the homepage, footer
    // social links and analytics pixels for logged-out visitors too — the
    // doc holds no secrets). Only admins can write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rate-limit buckets: written only by the Admin SDK (bypasses rules).
    // No client should ever touch these.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }
  }
}
