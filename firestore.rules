rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Users: readable by any logged-in user; writable only by the owner
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Donations: publicly readable; create requires auth; update restricted to owner
    // (interested users and viewCount can be updated by any authenticated user)
    match /donations/{donationId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['interestedUsers', 'viewCount', 'updatedAt'])
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Conversations: participants only
    match /conversations/{convId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if isAuth() && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false;
      }
    }

    // Notifications: only the recipient
    match /notifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth();
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // Reviews: publicly readable; create by authenticated users only; immutable after creation
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.reviewerId;
      allow update, delete: if false;
    }
  }
}
