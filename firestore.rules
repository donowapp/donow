rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // The acting user is in good standing (not suspended/banned). Used to gate
    // all content writes so moderation actually takes effect. Assumes the
    // caller's own /users doc exists (it is created at signup before any other
    // write happens).
    function isActive() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Deterministic conversation id the apps use: donationId_<sorted uids>.
    // Lets review rules prove a conversation exists between the two parties.
    function convIdFor(donationId, a, b) {
      return donationId + '_' + (a < b ? a + '_' + b : b + '_' + a);
    }

    // Users: PRIVATE. A user's full record (email, phone, home address,
    // pincode) is readable only by the owner or an admin. Public-facing fields
    // live in /publicProfiles. Owners may edit only their own profile fields;
    // sensitive fields (role, isVerified, status, emailConfirmed, counts) are
    // admin/server only.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Create is field-pinned: a user may only create their OWN doc and may
      // NOT self-assign privileged/trust fields. role/status/isVerified and the
      // reputation counters must start at safe defaults — promotion happens only
      // via the super-admin Admin SDK route. Without this, any signed-in user
      // could write role:'admin' to their own doc and become an admin.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.isVerified == false
        && request.resource.data.donationCount == 0
        && request.resource.data.receivedCount == 0
        && request.resource.data.rating == 0;
      // Admins may update anything EXCEPT role — role changes require the
      // super-admin API route (Admin SDK, bypasses rules). This prevents any
      // compromised admin account from promoting arbitrary users.
      allow update: if (isAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        (isOwner(userId) && isActive() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'phone', 'address', 'city', 'state', 'pincode',
                     'bio', 'profileImage', 'savedDonations', 'expoPushToken',
                     'updatedAt']));
      // Deletion happens only through the Admin SDK (self-serve /api/account/delete
      // and the MFA-gated /api/admin/delete-user), never a raw client write.
      allow delete: if false;
    }

    // Public profiles: the safe, world-readable subset of a user shown next to
    // donations (name, city/state, photo, verified badge, counts/rating).
    // Owners may set only their display fields; trust fields (isVerified,
    // rating, counts) are admin/server-written.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) &&
        request.resource.data.keys()
          .hasOnly(['name', 'city', 'state', 'profileImage', 'updatedAt']);
      allow update: if isAdmin() ||
        (isOwner(userId) && isActive() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'city', 'state', 'profileImage', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Donations: publicly readable; create requires an active owner; update by
    // owner, admin, or limited counter fields (by any active user).
    match /donations/{donationId} {
      allow read: if true;
      // Creation is server-only (/api/donations/create, Admin SDK) so the
      // per-day limit and active-account check are actually enforced.
      allow create: if false;
      allow update: if isAdmin() || (isActive() && (
        // Owner edits their own donation — but ownership and createdAt are immutable.
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.createdAt == resource.data.createdAt) ||
        // Any active user may ONLY bump viewCount by 1 and/or toggle their OWN
        // entry in interestedUsers — no foreign uids, no arbitrary counters,
        // no other fields. Prevents tampering with another donation's counters.
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['interestedUsers', 'viewCount', 'updatedAt']) &&
         request.resource.data.viewCount >= resource.data.viewCount &&
         request.resource.data.viewCount <= resource.data.viewCount + 1 &&
         request.resource.data.interestedUsers.removeAll(resource.data.interestedUsers)
           .hasOnly([request.auth.uid]) &&
         resource.data.interestedUsers.removeAll(request.resource.data.interestedUsers)
           .hasOnly([request.auth.uid]))
      ));
      // Owners delete their own; admin deletion goes via the MFA-gated
      // /api/admin/delete-donation (Admin SDK), not a raw admin client write.
      allow delete: if isActive() && resource.data.userId == request.auth.uid;
    }

    // Conversations: active participants only
    match /conversations/{convId} {
      allow read: if isAuth() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isActive() && request.auth.uid in request.resource.data.participantIds;
      // Participants may update (unread counts, last message) but may NOT alter
      // the participant set — otherwise one party could eject the other.
      allow update: if isActive() && request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if isActive() && request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow update: if isActive() &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'content']);
        allow delete: if false;
      }
    }

    // Notifications: only the recipient can read/update/delete. Creation is
    // server-only (/api/notifications/create, Admin SDK) — this stops a client
    // forging arbitrary notifications (spam/phishing) to other users.
    match /notifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if false;
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // Reviews: publicly readable; created by an active author with a valid
    // 1-5 rating; immutable by users; removable by admins (defamation/abuse).
    match /reviews/{reviewId} {
      allow read: if true;
      // A review is only allowed when there was a real transaction:
      //  - one review per (donation, reviewer): doc id pinned to
      //    "<donationId>_<reviewerId>" (a repeat hits `update`, denied);
      //  - no self-reviews;
      //  - the reviewee MUST own the donation (cross-doc read), so a reviewer
      //    can't aim reviews at an arbitrary victim;
      //  - the donation MUST be completed; and
      //  - a conversation MUST exist between the two parties for that donation.
      //  Together these stop review farming / reputation manipulation.
      //  Rating must be an int 1-5.
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.reviewerId &&
        request.resource.data.reviewerId != request.resource.data.revieweeId &&
        reviewId == request.resource.data.donationId + '_' + request.resource.data.reviewerId &&
        get(/databases/$(database)/documents/donations/$(request.resource.data.donationId)).data.userId
          == request.resource.data.revieweeId &&
        get(/databases/$(database)/documents/donations/$(request.resource.data.donationId)).data.status
          == 'completed' &&
        exists(/databases/$(database)/documents/conversations/$(convIdFor(
          request.resource.data.donationId, request.auth.uid, request.resource.data.revieweeId))) &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Announcements: publicly readable broadcasts; admin-managed.
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin action logs: append-only audit trail. Admins can read and add
    // entries, but no one may edit or delete them (so a rogue admin can't
    // tamper with the record of their own actions).
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Platform settings: publicly readable (drives the homepage, footer
    // social links and analytics pixels for logged-out visitors too — the
    // doc holds no secrets). Only admins can write.
    match /settings/{docId} {
      allow read: if true;
      // Writes only via the MFA-gated /api/admin/settings (Admin SDK). A stolen
      // admin token can't rewrite site-wide settings without a TOTP session.
      allow write: if false;
    }

    // Rate-limit buckets: written only by the Admin SDK (bypasses rules).
    // No client should ever touch these.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }

    // Admin TOTP secrets: server-only (Admin SDK bypasses rules). Holds the
    // shared 2FA secret, so no client must ever read or write it.
    match /adminMfa/{uid} {
      allow read, write: if false;
    }
  }
}
