rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // The acting user is in good standing (not suspended/banned). Used to gate
    // all content writes so moderation actually takes effect. Assumes the
    // caller's own /users doc exists (it is created at signup before any other
    // write happens).
    function isActive() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Users: PRIVATE. A user's full record (email, phone, home address,
    // pincode) is readable only by the owner or an admin. Public-facing fields
    // live in /publicProfiles. Owners may edit only their own profile fields;
    // sensitive fields (role, isVerified, status, emailConfirmed, counts) are
    // admin/server only.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() ||
        (isOwner(userId) && isActive() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'phone', 'address', 'city', 'state', 'pincode',
                     'bio', 'profileImage', 'savedDonations', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Public profiles: the safe, world-readable subset of a user shown next to
    // donations (name, city/state, photo, verified badge, counts/rating).
    // Owners may set only their display fields; trust fields (isVerified,
    // rating, counts) are admin/server-written.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) &&
        request.resource.data.keys()
          .hasOnly(['name', 'city', 'state', 'profileImage', 'updatedAt']);
      allow update: if isAdmin() ||
        (isOwner(userId) && isActive() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'city', 'state', 'profileImage', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Donations: publicly readable; create requires an active owner; update by
    // owner, admin, or limited counter fields (by any active user).
    match /donations/{donationId} {
      allow read: if true;
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isActive() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['interestedUsers', 'viewCount', 'updatedAt'])
      ));
      allow delete: if isAdmin() || (isActive() && resource.data.userId == request.auth.uid);
    }

    // Conversations: active participants only
    match /conversations/{convId} {
      allow read: if isAuth() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isActive() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isActive() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if isActive() && request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow update: if isActive() &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'content']);
        allow delete: if false;
      }
    }

    // Notifications: only the recipient can read/update/delete.
    // Creation is attributable — the creator must stamp their own uid.
    match /notifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // Reviews: publicly readable; created by an active author with a valid
    // 1-5 rating; immutable by users; removable by admins (defamation/abuse).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.reviewerId &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Announcements: publicly readable broadcasts; admin-managed.
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin action logs: admins only
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Platform settings: publicly readable (drives the homepage, footer
    // social links and analytics pixels for logged-out visitors too — the
    // doc holds no secrets). Only admins can write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rate-limit buckets: written only by the Admin SDK (bypasses rules).
    // No client should ever touch these.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }
  }
}
